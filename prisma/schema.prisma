generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  ASSISTED_LIVING
  MEMORY_CARE
  NURSING_HOME
}

enum UserRole {
  ADMIN
  CFO
  BILLING_MANAGER
  VIEWER
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  createdAt DateTime         @default(now())

  facilities Facility[]
  users      User[]
}

model Facility {
  id               String @id @default(cuid())
  name             String
  address          String
  totalBeds        Int
  currentOccupancy Int    @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(VIEWER)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
