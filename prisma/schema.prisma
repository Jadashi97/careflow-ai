generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum OrganizationType {
  ASSISTED_LIVING
  MEMORY_CARE
  NURSING_HOME
}

enum UserRole {
  ADMIN
  CFO
  BILLING_MANAGER
  VIEWER
}

enum CareLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  MEMORY_CARE
}

enum PaymentType {
  PRIVATE_PAY
  MEDICAID_WAIVER
  MIXED
}

enum ResidentStatus {
  ACTIVE
  DISCHARGED
  DECEASED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum MismatchStatus {
  DETECTED
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReminderChannel {
  EMAIL
  SMS
  PHONE
  LETTER
}

enum ReminderAction {
  SEND_REMINDER
  ESCALATE
  COLLECTIONS
}

enum CommunicationStatus {
  SENT
  DELIVERED
  FAILED
  RESPONDED
}

// ── Organization & Facility ────────────────────────────

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType
  createdAt DateTime         @default(now())

  facilities    Facility[]
  users         User[]
  reminderRules ReminderRule[]
}

model Facility {
  id               String @id @default(cuid())
  name             String
  address          String
  totalBeds        Int
  currentOccupancy Int    @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  residents        Resident[]
  revenueMismatches RevenueMismatch[]
}

// ── Users ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(VIEWER)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ── Residents & Care ───────────────────────────────────

model Resident {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  roomNumber    String
  admissionDate DateTime
  careLevel     CareLevel
  monthlyRate   Decimal        @db.Decimal(10, 2)
  paymentType   PaymentType
  status        ResidentStatus @default(ACTIVE)

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  contactName  String?
  contactPhone String?
  contactEmail String?

  carePlanChanges    CarePlanChange[]
  billingRecords     BillingRecord[]
  revenueMismatches  RevenueMismatch[]
  communicationLogs  CommunicationLog[]
}

model CarePlanChange {
  id            String    @id @default(cuid())
  previousLevel CareLevel
  newLevel      CareLevel
  effectiveDate DateTime
  documentedBy  String
  createdAt     DateTime  @default(now())

  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])

  revenueMismatches RevenueMismatch[]
}

// ── Billing ────────────────────────────────────────────

model BillingRecord {
  id            String        @id @default(cuid())
  billingMonth  DateTime
  careLevel     CareLevel
  amountBilled  Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @db.Decimal(10, 2) @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  dueDate       DateTime
  paidDate      DateTime?

  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])

  revenueMismatches  RevenueMismatch[]
  communicationLogs  CommunicationLog[]
}

// ── Revenue Mismatch Detection ─────────────────────────

model RevenueMismatch {
  id           String         @id @default(cuid())
  expectedRate Decimal        @db.Decimal(10, 2)
  actualRate   Decimal        @db.Decimal(10, 2)
  monthlyGap   Decimal        @db.Decimal(10, 2)
  status       MismatchStatus @default(DETECTED)
  detectedAt   DateTime       @default(now())

  residentId      String
  resident        Resident @relation(fields: [residentId], references: [id])

  facilityId      String
  facility        Facility @relation(fields: [facilityId], references: [id])

  carePlanChangeId String
  carePlanChange   CarePlanChange @relation(fields: [carePlanChangeId], references: [id])

  billingRecordId  String
  billingRecord    BillingRecord @relation(fields: [billingRecordId], references: [id])
}

// ── Accounts Receivable ────────────────────────────────

model ReminderRule {
  id             String         @id @default(cuid())
  name           String
  daysOverdue    Int
  channel        ReminderChannel
  action         ReminderAction
  messageTemplate String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model CommunicationLog {
  id          String              @id @default(cuid())
  channel     ReminderChannel
  action      ReminderAction
  subject     String
  message     String
  status      CommunicationStatus @default(SENT)
  response    String?
  sentAt      DateTime            @default(now())
  respondedAt DateTime?

  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])

  billingRecordId String?
  billingRecord   BillingRecord? @relation(fields: [billingRecordId], references: [id])
}
